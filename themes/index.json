{
  "default": "matte",
  "themes": {
    "matte": ["matte.css"],
    "md3e": ["md3e-tokens.css", "md3e.css", "md3e-icons.css"]
  },
  "fonts": {
    "md3e": [
      { "family": "Roboto", "file": "../vendor/md3e/roboto-variable.woff2", "weight": "100 900", "stretch": "75% 100%" }
    ]
  },
  "ripple": ["md3e"],
  "options": [
    { "key": "matte",       "name": "Matte",                 "theme": "matte", "swatch": "#ededee" },
    { "key": "md3e-teal",   "name": "Material 3 · Teal",     "theme": "md3e",  "swatch": "#a5faf9" },
    { "key": "md3e-ocean",  "name": "Material 3 · Ocean",    "theme": "md3e",  "seed": "ocean",  "swatch": "#9ecefe" },
    { "key": "md3e-forest", "name": "Material 3 · Forest",   "theme": "md3e",  "seed": "forest", "swatch": "#c8f2ae" },
    { "key": "md3e-amber",  "name": "Material 3 · Amber",    "theme": "md3e",  "seed": "amber",  "swatch": "#fecd79" },
    { "key": "md3e-coral",  "name": "Material 3 · Coral",    "theme": "md3e",  "seed": "coral",  "swatch": "#ffa6a8" }
  ]
}
